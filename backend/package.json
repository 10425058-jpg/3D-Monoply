{
  "name": "monopoly-3d-backend",
  "version": "0.2.1",
  "private": true,
  "description": "NestJS backend for 3D Monopoly online multiplayer (mini-v1 ruleset).",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/engine.test.ts test/session-cleanup.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:constraints": "prisma db execute --file prisma/sql/constraints.sql --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.16.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "multer": "2.5.0"
  }
}
