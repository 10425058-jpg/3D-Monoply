# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# Port the backend listens on (API at http://localhost:3000/api/v1)
PORT=3000

# Frontend URL(s) allowed to call the API and open sockets. Comma-separated. Vite dev server = 5173.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection. These placeholder values match docker-compose.yml.
DATABASE_URL="postgresql://monopoly:change-me@localhost:5432/monopoly_dev?schema=public"

# Secret used to sign 15-minute access tokens. Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string

# Set to true when the site is served over HTTPS (production). Keep false on http://localhost.
COOKIE_SECURE=false

# Optional: seconds a player may be disconnected before the match pauses (default 120).
# Lower it (for example 10) only to test pause/resume quickly on your own computer.
# DISCONNECT_GRACE_SECONDS=120

# Trust this many edge reverse proxies when deriving req.ip (0 local; 1 Render).
# Only enable when clients cannot directly bypass your trusted proxy.
TRUST_PROXY_HOPS=0
