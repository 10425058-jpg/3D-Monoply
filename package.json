{
  "name": "monopoly-3d-city",
  "private": true,
  "version": "1.0.0",
  "description": "A complete 3D property trading board game featuring an interactive miniature island city diorama.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "test:online": "node --import tsx --test tests/online.test.ts",
    "test:online-browser": "node scripts/online-browser.mjs",
    "test:animations": "node --test tests/animations.test.mjs",
    "preview": "vite preview",
    "test:graphics": "node --test tests/graphics.test.mjs",
    "audit:graphics": "node scripts/graphics-audit.mjs",
    "test:graphics-browser": "node scripts/graphics-regression.mjs",
    "test:environment-assets": "node --test tests/environment-assets.test.mjs",
    "audit:environment": "node scripts/phase2-audit.mjs",
    "test:environment-browser": "node scripts/environment-regression.mjs",
    "audit:fantasy-polish": "node scripts/atmosphere-audit.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.4",
    "@react-three/fiber": "^8.16.2",
    "@react-three/postprocessing": "2.16.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.164.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.16.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.164.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "overrides": {
    "@react-three/postprocessing": {
      "postprocessing": "6.35.6"
    }
  }
}
