# Default: same-origin /api/v1 and /game. Vite proxies HTTP and Socket.IO to localhost:3000.
# For direct local API access, use the SAME hostname for frontend and backend.
# VITE_API_BASE_URL=http://localhost:3000/api/v1
# VITE_SOCKET_URL=http://localhost:3000/game
# Production should reverse-proxy /api/v1 and /socket.io to NestJS on the same origin.
